# Settings for check.py on the OFF-DROPLET host. Copy to ~/.config/offsite-checker.env,
# fill in, then: chmod 600 ~/.config/offsite-checker.env

# Journal in Backblaze B2 (an rclone remote configured with a READ-ONLY key)
CHECKER_RCLONE_REMOTE=b2journal:atb-fresh-activity-journal

# Production state endpoint and its bearer token (same value as ACTIVITY_JOURNAL_STATE_TOKEN in the production .env)
CHECKER_STATE_URL=https://attb.in/monitoring/state
CHECKER_STATE_TOKEN=

# A NEW Healthchecks check, separate from the export job's check
CHECKER_PING_URL=

# Optional
# CHECKER_STATE_FILE=~/.local/state/offsite-checker/state.json
# CHECKER_MAX_LAG_HOURS=3
# CHECKER_RCLONE_BINARY=rclone
